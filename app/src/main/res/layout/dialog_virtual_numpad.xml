<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_md3_dialog_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:text="智能电视虚拟数字选台面板"
        android:textColor="@color/md_theme_dark_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="使用遥控器【方向键】移动焦点，按【OK键】输入频道号"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Material 3 台号输入显示与频道名称实时匹配预览卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_md3_card_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tv_numpad_digits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:minWidth="76dp"
            android:text="---"
            android:textColor="@color/accent_amber"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_numpad_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="请选择频道号 (如: 1=CCTV1, 21=北京卫视, 85=CCTV-4K)"
            android:textColor="@color/accent_green"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3x4 Material 3 触感虚拟数字键盘网格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_numpad_1"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="1"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_2"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="2"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_3"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="3"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_numpad_4"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="4"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_5"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="5"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_6"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="6"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_numpad_7"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="7"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_8"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="8"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_9"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="9"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 4: 退格清空, 0, 立即跳转 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_numpad_del"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="⌫ 退格"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_numpad_0"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_md3_numpad_key"
                android:focusable="true"
                android:text="0"
                android:textSize="19sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_numpad_go"
                style="@style/Widget.BjUnicomIptv.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:focusable="true"
                android:text="立即跳转 ▶"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
