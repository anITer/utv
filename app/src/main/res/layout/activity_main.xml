<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 1. ijkplayer 视频渲染主视图 -->
    <com.bjunicom.iptv.player.IjkVideoView
        android:id="@+id/ijk_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false" />

    <!-- 2. Material 3 缓冲加载与状态提示浮层 (高透光 + 边缘立体阴影) -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_md3_hud_surface"
        android:elevation="18dp"
        android:gravity="center"
        android:minWidth="220dp"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
        android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
        android:paddingHorizontal="28dp"
        android:paddingVertical="22dp"
        android:translationZ="4dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/md_theme_dark_primary" />

        <TextView
            android:id="@+id/tv_loading_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:shadowColor="@color/ui_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="3.5"
            android:text="正在连接组播流..."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 3. 右上角遥控器数字选台 Material 3 悬浮胶囊 OSD (高透光 + 边缘立体阴影) -->
    <TextView
        android:id="@+id/tv_number_input_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_md3_hud_surface"
        android:elevation="20dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
        android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:shadowColor="@color/ui_text_shadow"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4.0"
        android:textColor="@color/accent_green"
        android:textSize="24sp"
        android:textStyle="bold"
        android:translationZ="6dp"
        android:visibility="gone"
        tools:text="001  CCTV-1综合" />

    <!-- 3.5 观看暂停状态中心悬浮图标 (双击 OK 键暂停时显示，再次双击 OK 键恢复后消失) -->
    <ImageView
        android:id="@+id/iv_pause_icon"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_md3_hud_surface"
        android:contentDescription="已暂停"
        android:elevation="20dp"
        android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
        android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
        android:padding="22dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_flat_pause"
        android:translationZ="6dp"
        android:visibility="gone" />

    <!-- 3.6 暂停恢复后 1.5 倍速快放追帧右下角提示徽章 (追上直播时间戳后消失) -->
    <TextView
        android:id="@+id/tv_catchup_speed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_md3_hud_surface"
        android:elevation="20dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
        android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:shadowColor="@color/ui_text_shadow"
        android:shadowDx="0"
        android:shadowDy="1.5"
        android:shadowRadius="3.5"
        android:text="1.5x"
        android:textColor="@color/accent_amber"
        android:textSize="18sp"
        android:textStyle="bold"
        android:translationZ="6dp"
        android:visibility="gone" />

    <!-- 4. Material Design 3 顶部与底部悬浮式播放控制 HUD -->
    <RelativeLayout
        android:id="@+id/player_hud_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="visible">

        <!-- 顶部悬浮 Top App Bar (高透光避免遮挡左上/右上角台标 + 边缘立体阴影) -->
        <LinearLayout
            android:id="@+id/top_hud_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_md3_hud_surface"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
            android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:translationZ="4dp">

            <Button
                android:id="@+id/btn_toggle_drawer"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_flat_menu"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:nextFocusDown="@id/btn_prev_channel"
                android:nextFocusLeft="@id/btn_reload_stream"
                android:nextFocusRight="@id/btn_switch_isp"
                android:nextFocusUp="@id/btn_prev_channel"
                android:paddingHorizontal="14dp"
                android:text="频道列表"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_switch_isp"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:nextFocusDown="@id/btn_prev_channel"
                android:nextFocusLeft="@id/btn_toggle_drawer"
                android:nextFocusRight="@id/btn_upload_m3u"
                android:nextFocusUp="@id/btn_prev_channel"
                android:paddingHorizontal="14dp"
                android:text="北京联通"
                android:textColor="@color/accent_amber"
                android:textSize="13sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/ic_md_live_dot" />

            <TextView
                android:id="@+id/tv_top_channel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:shadowColor="@color/ui_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1.5"
                android:shadowRadius="3.5"
                android:singleLine="true"
                android:text="001 CCTV-1综合 [高清]"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 实时速率与帧率 Material Tonal Chip -->
            <TextView
                android:id="@+id/tv_top_stream_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_channel_num_pill"
                android:elevation="4dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:shadowColor="@color/ui_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1.5"
                android:shadowRadius="3.0"
                android:singleLine="true"
                android:text="0 KB/s | 25 fps"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_upload_m3u"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_flat_upload"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:nextFocusDown="@id/btn_favorite_channel"
                android:nextFocusLeft="@id/btn_switch_isp"
                android:nextFocusRight="@id/btn_open_scanner"
                android:nextFocusUp="@id/btn_favorite_channel"
                android:paddingHorizontal="14dp"
                android:text="上传M3U"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_open_scanner"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:drawableStart="@drawable/ic_flat_radar"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:nextFocusDown="@id/btn_aspect_ratio"
                android:nextFocusLeft="@id/btn_upload_m3u"
                android:nextFocusRight="@id/btn_open_settings"
                android:nextFocusUp="@id/btn_aspect_ratio"
                android:paddingHorizontal="14dp"
                android:text="组播扫描"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_open_settings"
                style="@style/Widget.BjUnicomIptv.HudButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:drawableStart="@drawable/ic_flat_settings"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:nextFocusDown="@id/btn_reload_stream"
                android:nextFocusLeft="@id/btn_open_scanner"
                android:nextFocusRight="@id/btn_prev_channel"
                android:nextFocusUp="@id/btn_reload_stream"
                android:paddingHorizontal="14dp"
                android:text="播放设置"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 底部悬浮播放信息与快捷控制卡片 (高透光 + 边缘立体阴影) -->
        <LinearLayout
            android:id="@+id/bottom_hud_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_md3_hud_surface"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="18dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
            android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            android:translationZ="4dp">

            <!-- 第一行：频道徽章 + 标题 + 动作按钮组 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tv_osd_channel_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_channel_num_pill"
                    android:elevation="4dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="001"
                    android:textColor="@color/accent_amber"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_osd_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxWidth="240dp"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.5"
                    android:singleLine="true"
                    android:text="CCTV-1综合"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_osd_resolution_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_res_badge_hd"
                    android:elevation="4dp"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2.5"
                    android:singleLine="true"
                    android:text="高清"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_osd_group_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="[高清]央视"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_prev_channel"
                    style="@style/Widget.BjUnicomIptv.HudButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_flat_prev"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_toggle_drawer"
                    android:nextFocusLeft="@id/btn_open_settings"
                    android:nextFocusRight="@id/btn_next_channel"
                    android:nextFocusUp="@id/btn_toggle_drawer"
                    android:paddingHorizontal="12dp"
                    android:text="上一台"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_next_channel"
                    style="@style/Widget.BjUnicomIptv.HudButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_flat_next"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_toggle_drawer"
                    android:nextFocusLeft="@id/btn_prev_channel"
                    android:nextFocusRight="@id/btn_numpad_dialog"
                    android:nextFocusUp="@id/btn_toggle_drawer"
                    android:paddingHorizontal="12dp"
                    android:text="下一台"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_numpad_dialog"
                    style="@style/Widget.BjUnicomIptv.HudButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_flat_dialpad"
                    android:drawablePadding="5dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_toggle_drawer"
                    android:nextFocusLeft="@id/btn_next_channel"
                    android:nextFocusRight="@id/btn_favorite_channel"
                    android:nextFocusUp="@id/btn_toggle_drawer"
                    android:paddingHorizontal="12dp"
                    android:text="数字选台"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_favorite_channel"
                    style="@style/Widget.BjUnicomIptv.HudButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_flat_star_outline"
                    android:drawablePadding="5dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_open_scanner"
                    android:nextFocusLeft="@id/btn_numpad_dialog"
                    android:nextFocusRight="@id/btn_aspect_ratio"
                    android:nextFocusUp="@id/btn_open_scanner"
                    android:paddingHorizontal="12dp"
                    android:text="收藏"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_aspect_ratio"
                    style="@style/Widget.BjUnicomIptv.HudButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_flat_aspect_ratio"
                    android:drawablePadding="5dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_open_scanner"
                    android:nextFocusLeft="@id/btn_favorite_channel"
                    android:nextFocusRight="@id/btn_reload_stream"
                    android:nextFocusUp="@id/btn_open_scanner"
                    android:paddingHorizontal="12dp"
                    android:text="画面比例"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_reload_stream"
                    style="@style/Widget.BjUnicomIptv.HudButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:drawableStart="@drawable/ic_flat_refresh"
                    android:drawablePadding="5dp"
                    android:focusable="true"
                    android:nextFocusDown="@id/btn_open_settings"
                    android:nextFocusLeft="@id/btn_aspect_ratio"
                    android:nextFocusRight="@id/btn_toggle_drawer"
                    android:nextFocusUp="@id/btn_open_settings"
                    android:paddingHorizontal="12dp"
                    android:text="重连"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#40A8C7FA" />

            <!-- 第二行：流协议地址与音视频轨道详情 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_osd_stream_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="组播源: rtp://239.3.1.129:8008 -> http://192.168.2.1:8012/rtp/239.3.1.129:8008"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_osd_track_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="Video: #1 h264, 1920x1080,25fps | Audio: #1 mp2,2ch,48khz"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第三行：遥控器与触屏操作提示栏 -->
            <TextView
                android:id="@+id/tv_remote_help_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:shadowColor="@color/ui_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1.5"
                android:shadowRadius="3.0"
                android:singleLine="true"
                android:text="遥控器导航: [◄/►]调出频道列表/切换按钮  [OK]调出信息页/确认  [双击OK]暂停/恢复  [长按OK 2秒]时移回看  [▲/▼]上下换台  [菜单]快捷面板"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 4.5 北京联通 IPTV 时移回看进度条与缩略图预览浮层 (长按 OK 键 2 秒呼出) -->
    <RelativeLayout
        android:id="@+id/timeshift_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <!-- Seek 过程中的视频缩略图悬浮预览卡片 (跟随 SeekBar 游标上方显示) -->
        <LinearLayout
            android:id="@+id/timeshift_thumbnail_container"
            android:layout_width="224dp"
            android:layout_height="wrap_content"
            android:layout_above="@+id/timeshift_bar_card"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_md3_hud_surface"
            android:elevation="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
            android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
            android:padding="8dp"
            android:translationZ="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_timeshift_thumbnail"
                android:layout_width="208dp"
                android:layout_height="117dp"
                android:background="#800F172A"
                android:contentDescription="时移缩略图画面"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/tv_timeshift_thumb_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:shadowColor="@color/ui_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1.5"
                android:shadowRadius="3.0"
                android:singleLine="true"
                android:text="12:00:00 (-00:05:00)"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 底部时移 SeekBar 控制卡片 -->
        <LinearLayout
            android:id="@+id/timeshift_bar_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_md3_hud_surface"
            android:elevation="20dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
            android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
            android:paddingHorizontal="22dp"
            android:paddingVertical="16dp"
            android:translationZ="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_timeshift_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_channel_num_pill"
                    android:elevation="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="↺ 时移回看"
                    android:textColor="@color/accent_amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_timeshift_channel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.5"
                    android:singleLine="true"
                    android:text="001 CCTV-1综合"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_timeshift_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="12:00:00"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_timeshift_live_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/ui_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1.5"
                    android:shadowRadius="3.0"
                    android:singleLine="true"
                    android:text="/ 12:00:00 (直播)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_timeshift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:focusable="true"
                android:max="21600"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingVertical="6dp"
                android:progress="21600"
                android:progressTint="@color/md_theme_dark_primary"
                android:splitTrack="false"
                android:thumbTint="@color/accent_amber" />

            <TextView
                android:id="@+id/tv_timeshift_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:shadowColor="@color/ui_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1.5"
                android:shadowRadius="3.0"
                android:singleLine="true"
                android:text="遥控器导航: [◄/►]快退/快进时移并预览缩略图  [OK]立即跳转/返回直播  [返回]收起进度条"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 5. 左侧 Material Design 3 Navigation Drawer / Side Sheet 频道面板 (高透光避免遮挡左上角台标 + 边缘立体阴影) -->
    <LinearLayout
        android:id="@+id/channel_drawer_panel"
        android:layout_width="456dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_md3_drawer_sheet"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:descendantFocusability="afterDescendants"
        android:elevation="24dp"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/ui_edge_shadow_ambient"
        android:outlineSpotShadowColor="@color/ui_edge_shadow_spot"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:translationZ="6dp"
        android:visibility="gone">

        <!-- Material 3 Pill Search Bar -->
        <EditText
            android:id="@+id/et_search_channel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_md3_search_bar"
            android:drawableStart="@drawable/ic_md_search"
            android:drawablePadding="10dp"
            android:elevation="6dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center_vertical"
            android:hint="搜索频道名 / 台号 / 239.3.1.x..."
            android:imeOptions="actionSearch"
            android:includeFontPadding="false"
            android:inputType="text"
            android:nextFocusDown="@id/rv_categories"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:shadowColor="@color/ui_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2.5"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Material 3 Filter Chips 横向分类栏 (严格限制在频道列表右边界范围内) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:nextFocusDown="@id/rv_channels"
            android:nextFocusUp="@id/et_search_channel"
            android:overScrollMode="never"
            android:paddingHorizontal="0dp"
            android:paddingVertical="4dp" />

        <!-- Material 3 频道卡片列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nextFocusUp="@id/rv_categories"
            android:overScrollMode="never"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:scrollbars="vertical" />

        <!-- 抽屉底部操作指引 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="@color/ui_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="3.0"
            android:singleLine="true"
            android:text="[▲/▼]选台  [◄/►]切换分类  [OK]播放  [长按OK]收藏  [返回]收起"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
