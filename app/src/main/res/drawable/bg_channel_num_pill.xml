<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#28A8C7FA" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke
                android:width="1dp"
                android:color="#66A8C7FA" />
        </shape>
    </item>
</layer-list>
