<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_theme_dark_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#59000000" />
                            <corners android:radius="10dp" />
                        </shape>
                    </item>
                    <item
                        android:bottom="2.5dp"
                        android:left="1dp"
                        android:right="1.5dp"
                        android:top="0.5dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="#9E163E85"
                                android:startColor="#B32563EB" />
                            <corners android:radius="@dimen/ui_corner_radius" />
                            <stroke
                                android:width="2.2dp"
                                android:color="#FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_selected="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#42000000" />
                            <corners android:radius="10dp" />
                        </shape>
                    </item>
                    <item
                        android:bottom="2dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="0.5dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="#730E2F66"
                                android:startColor="#85154596" />
                            <corners android:radius="@dimen/ui_corner_radius" />
                            <stroke
                                android:width="1.5dp"
                                android:color="@color/accent_cyan" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#40000000" />
                            <corners android:radius="10dp" />
                        </shape>
                    </item>
                    <item
                        android:bottom="2dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="0.5dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#852D3D59" />
                            <corners android:radius="@dimen/ui_corner_radius" />
                            <stroke
                                android:width="1dp"
                                android:color="#66A8C7FA" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#33000000" />
                            <corners android:radius="10dp" />
                        </shape>
                    </item>
                    <item
                        android:bottom="2dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="0.5dp">
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="270"
                                android:endColor="#47131C2B"
                                android:startColor="#541E2B40" />
                            <corners android:radius="@dimen/ui_corner_radius" />
                            <stroke
                                android:width="1dp"
                                android:color="#3DFFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
