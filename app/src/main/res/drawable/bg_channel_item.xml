<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_theme_dark_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_card_focused" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke android:width="2dp" android:color="@color/md_theme_dark_primary" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_card_selected" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke android:width="1.5dp" android:color="@color/accent_cyan" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_dark_surfaceContainerHighest" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_dark_surfaceContainer" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke android:width="1dp" android:color="#22FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
