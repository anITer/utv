<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 抽屉外缘立体多层阴影 (重点强化右侧与底部悬浮边缘投影) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="0dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#3D000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:bottom="3.5dp"
        android:left="0dp"
        android:right="4dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- 高透光抽屉主面板 (约 50%~56% 不透明度，透出左上角台标与实时画面) -->
    <item
        android:bottom="4.5dp"
        android:left="0dp"
        android:right="5dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#7D101827"
                android:endColor="#8F0B111D"
                android:startColor="#85162236" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke
                android:width="1.2dp"
                android:color="#66A8C7FA" />
        </shape>
    </item>
    <!-- 内缘立体高光描边 -->
    <item
        android:bottom="5.5dp"
        android:left="1dp"
        android:right="6dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="7dp" />
            <stroke
                android:width="0.8dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
