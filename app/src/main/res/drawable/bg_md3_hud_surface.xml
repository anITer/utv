<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层环境柔光阴影环 (1) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <!-- 中层立体边缘阴影环 (2) -->
    <item
        android:bottom="1.5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#36000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- 内层深邃贴边投影 (3) -->
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D000000" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <!-- 高透光毛玻璃质感主面板 (约 46%~52% 不透明度，避免遮挡台标与字幕) -->
    <item
        android:bottom="4dp"
        android:left="2.5dp"
        android:right="2.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#73111B2C"
                android:endColor="#850B121E"
                android:startColor="#7A18263C" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke
                android:width="1.2dp"
                android:color="#66A8C7FA" />
        </shape>
    </item>
    <!-- 顶部/内缘立体高光倒角边线 -->
    <item
        android:bottom="5dp"
        android:left="3.5dp"
        android:right="3.5dp"
        android:top="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="7dp" />
            <stroke
                android:width="0.8dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
