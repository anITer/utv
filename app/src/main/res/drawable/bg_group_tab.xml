<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_theme_dark_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="#2563EB" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke android:width="2.5dp" android:color="#FFFFFF" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_dark_primaryContainer" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke android:width="1.5dp" android:color="@color/md_theme_dark_primary" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_dark_surfaceContainerHighest" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/md_theme_dark_surfaceContainerHigh" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke android:width="1dp" android:color="@color/md_theme_dark_outlineVariant" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
