<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_theme_dark_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#59000000" />
                            <corners android:radius="10dp" />
                        </shape>
                    </item>
                    <item
                        android:bottom="2dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="0.5dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#B32563EB" />
                            <corners android:radius="@dimen/ui_corner_radius" />
                            <stroke
                                android:width="2dp"
                                android:color="#FFFFFF" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#8C2D3D59" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                </shape>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="#36000000" />
                            <corners android:radius="10dp" />
                        </shape>
                    </item>
                    <item
                        android:bottom="2dp"
                        android:left="1dp"
                        android:right="1dp"
                        android:top="0.5dp">
                        <shape android:shape="rectangle">
                            <solid android:color="#66233046" />
                            <corners android:radius="@dimen/ui_corner_radius" />
                            <stroke
                                android:width="1dp"
                                android:color="#4DA8C7FA" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
