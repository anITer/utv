<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:bottom="3.5dp"
        android:left="2dp"
        android:right="2dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#A60D1422"
                android:startColor="#99162236" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke
                android:width="1.2dp"
                android:color="#59A8C7FA" />
        </shape>
    </item>
</layer-list>
