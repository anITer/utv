<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#B32563EB" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#8C0842A0" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke android:width="1.5dp" android:color="@color/md_theme_dark_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#8C2D3D59" />
            <corners android:radius="@dimen/ui_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#59233046" />
            <corners android:radius="@dimen/ui_corner_radius" />
            <stroke android:width="1dp" android:color="#45A8C7FA" />
        </shape>
    </item>
</selector>
