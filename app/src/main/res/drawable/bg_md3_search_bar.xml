<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4D000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="1dp"
                android:right="1dp"
                android:top="0.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#80283750" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/md_theme_dark_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="1dp"
                android:right="1dp"
                android:top="0.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#521C273A" />
                    <corners android:radius="@dimen/ui_corner_radius" />
                    <stroke
                        android:width="1dp"
                        android:color="#4DA8C7FA" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
